# Endpoint layer environment. Copy to endpoints/.env and edit.
#
# This file is committed as a template only. The real endpoints/.env is
# gitignored. Nothing here is a real secret: the model servers are loopback
# only, so there is no credential worth protecting on the Ollama side.

# Key every caller must present to the LiteLLM proxy. The proxy refuses
# /v1/models and all inference routes without it, which is what keeps an
# unauthenticated model endpoint from being reachable.
#
# This value is a throwaway. It is loopback-only, but do not reuse it
# anywhere real and do not commit endpoints/.env.
LITELLM_MASTER_KEY=sk-local-not-secure

# --- Endpoint A: planning roles (architect, techlead, docs) ---------------
OLLAMA_A_HOST=127.0.0.1
OLLAMA_A_PORT=11434
OLLAMA_A_MODEL=qwen2.5:3b

# --- Endpoint B: execution roles (coder-1, coder-2, tester, deploy) ------
# A second server process with its own model directory, not a second model on
# the same server. The assignment requires two separate endpoints.
#
# Endpoint B's model must emit native tool calls or it cannot drive an agent.
# Verified with: python3 endpoints/toolcheck.py --port $OLLAMA_B_PORT \
#   --model $OLLAMA_B_MODEL --stream
OLLAMA_B_HOST=127.0.0.1
OLLAMA_B_PORT=11435
OLLAMA_B_MODEL=qwen2.5-coder:7b

# Where endpoint B keeps its weights. Must differ from endpoint A's directory.
OLLAMA_B_MODELS=$HOME/.ollama-b/models

# --- Bind addresses -------------------------------------------------------
# Nothing in this stack is reachable off-host. Do not change these to 0.0.0.0.
LITELLM_BIND=127.0.0.1:4000
OPENHANDS_BIND=127.0.0.1:8000
