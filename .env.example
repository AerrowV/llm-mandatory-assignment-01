# Every setting this project has. Copy to .env and edit:
#
#   cp .env.example .env
#
# `.env` is gitignored; this template is committed. Nothing here is a real
# secret: both model servers are loopback-only, so the proxy key is a throwaway.
#
# This file is the single source of truth. `scripts/config.py` reads it and
# writes the three files that used to hold the same values in three places:
#
#   endpoints/config.yml                      model -> endpoint routing
#   openhands/state/profiles/<role>.json      role  -> LiteLLM alias
#   openhands/state/agent-profiles/<role>.json which agent runs, on which alias
#
# Change a model here, then `docker compose restart litellm`. Never edit those
# three by hand: they are overwritten on every `scripts/agent.py` run.

# --- the proxy key ---------------------------------------------------------
# Every caller must present this to LiteLLM. Without it the proxy answers 401 on
# /v1/models and on all inference routes. It arrives via env_file in
# docker-compose.yml, which is the only supported way: putting `master_key:` in
# endpoints/config.yml moves auth onto LiteLLM's virtual-key path, which needs a
# database and then fails every agent turn with 400 "No connected db." while
# /v1/models keeps answering, so the fault looks like a dead model.
LITELLM_MASTER_KEY=sk-local-not-secure

# --- where the stack lives -------------------------------------------------
# Host-side URLs, for the scripts in scripts/ and the checks in docker/.
LITELLM_URL=http://localhost:4000
AGENT_URL=http://localhost:8000
# Container-side. The agent server and the proxy talk over the compose network,
# so this is the service name, not localhost.
LITELLM_BASE_URL=http://litellm:4000
# The repo as the agents see it. This is the mount point in docker-compose.yml
# and the prefix every absolute path in a prompt is built from.
WORKDIR=/opt/project
# Which directory inside WORKDIR the coding and testing roles work in.
DEMO_PROJECT=workspace/demo-project
# Published ports. Both stay on 127.0.0.1; see docker/validate.sh check 2.
LITELLM_BIND=127.0.0.1:4000
AGENT_BIND=127.0.0.1:8000

# --- the two model servers -------------------------------------------------
# The assignment requires two *separate* servers, not two models on one, so
# endpoint B is a second ollama process with its own weights directory.
# Start it with: OLLAMA_HOST=127.0.0.1:$ENDPOINT_B_PORT \
#   OLLAMA_MODELS=$HOME/.ollama-b/models ollama serve
ENDPOINT_A_HOST=127.0.0.1
ENDPOINT_A_PORT=11434
ENDPOINT_B_HOST=127.0.0.1
ENDPOINT_B_PORT=11435
# Where endpoint B keeps its weights. Must differ from endpoint A's directory.
ENDPOINT_B_MODELS=$HOME/.ollama-b/models

# --- models ----------------------------------------------------------------
# Which model serves each endpoint. Change a model here and nowhere else.
#
# Both must emit *native* tool calls. A model that returns the call as prose in
# `content` instead of in `tool_calls` cannot drive an agent, and the symptom is
# the agent narrating a plan instead of acting. Verify before trusting:
#
#   python3 endpoints/toolcheck.py --port $ENDPOINT_B_PORT \
#     --model $ENDPOINT_B_MODEL --stream
#
# Do NOT use qwen2.5-coder:7b: measured returning tool calls as text.
#
# Endpoint B ran qwen3:8b until 2026-10-04, when the model stopped answering
# outright - a bare completion hung past a 300s timeout with the weights
# resident and zero tokens billed, and stayed wedged after a server restart. The
# failure is silent: the proxy returns no error and /v1/models still answers.
# qwen2.5:7b-instruct is verified in both streaming and non-streaming mode.
ENDPOINT_A_MODEL=qwen2.5:3b
ENDPOINT_B_MODEL=qwen2.5:7b-instruct

# --- which endpoint serves which role --------------------------------------
# Comma-separated role names. Any role not listed here is an error, so a typo
# cannot quietly leave a role unrouted. Moving a role between endpoints is a
# one-line edit here plus `docker compose restart litellm`; no prompt, profile
# or script changes.
#
# A = reasoning-heavy, tool-light. B = must really create files and run
# commands, which is where a non-tool-trained model would break FR3/FR4.
ENDPOINT_A_ROLES=architect,techlead,docs
ENDPOINT_B_ROLES=coder-1,coder-2,tester,deploy-validator

# --- agent behaviour -------------------------------------------------------
# One shared context-window declaration for every alias. An OpenHands request is
# ~20k tokens (system prompt plus 20 tool schemas) and LiteLLM silently
# truncates against this value; a truncated model ignores its task and answers
# with unrelated text. Do not lower it.
MAX_INPUT_TOKENS=32768
MAX_OUTPUT_TOKENS=4096
# temperature 0 is deliberate: these runs are compared against each other for
# non-functional requirement 2, and a sampling run is not comparable.
TEMPERATURE=0
# Wall-clock ceiling per LLM call, seconds.
LLM_TIMEOUT=300
# Ceiling on agent turns per conversation. A worker that loops read-then-plan
# forever stops here.
MAX_ITERATIONS=100
# Default per-stage wall-clock cap in seconds, 0 for no cap. Overridden by
# --budget.
STAGE_BUDGET=1200
# never | risky | always. Non-functional requirement 1 wants a control
# mechanism. `never` is the only setting an unattended pipeline can use.
# `risky` pauses on shell commands and destructive file operations.
CONFIRMATION=never

# --- skills ----------------------------------------------------------------
# OpenHands injects its whole bundled skill library into every system prompt
# regardless of the enabled_skills setting, and the agent then spends turns
# invoking frontend and design skills for tasks that need none. An empty
# enabled_skills does not stop it; this deny-list does. One name per entry,
# comma-separated. Written into all seven agent profiles.
DISABLED_SKILLS=add-javadoc,add-skill,agent-canvas-environment,agent-creator,agent-memory,agent-readiness-report,agent-sdk-builder,azure-devops,bitbucket,bitbucket-cloud,bitbucket-data-center,build-setup,canvas-extension-api,cobol-modernization,code-review,code-simplifier,custom-codereview-guide.md,datadog,deno,discord,docker,evidence-based-citations,flarglebargle,frontend-design,github,github-actions,github-agents-md-maintainer,github-delivery-watchdog,github-issue-to-pr,github-issue-triage,github-pr-review,github-pr-reviewer,github-repo-monitor,github-stale-ci-pr-closer,gitlab,gitlab-issue-to-mr,improve-agent-readiness,incident-retrospective,index.d.ts,index.js,iterate,jira-issue-to-pr,jupyter,kubernetes,learn-from-code-review,linear,linear-triage,magic-word,mainframe-planning,mainframe-removal,migration-mapping,migration-report,migration-scoring,news-digest,notion,npm,openhands-api,openhands-automation,openhands-enterprise-troubleshooting,openhands-sdk,pdflatex,plain-english-content,prd,qa-changes,release-notes,research-brief,score-quality,score-style,security,setup-agents-md,setup-openhands,setup-pr-review,skill-creator,slack-channel-monitor,slack-standup-digest,spark-version-upgrade,ssh,swift-linux,technical-writing,theme-factory,ticket-to-code-change,to-java-migration,upstream-fork-sync,use-jev,uv,vercel